(version 1)

(rule "Internal footprint pad clearance"
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent")
    (constraint clearance (min 0.15mm))
)

(rule "JLCPCB PTH-to-track clearance"
    (constraint hole_clearance (min 0.28mm))
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track' && A.Net != B.Net")
)